From 7dc6fa0b759b7fbe6f4996fb3edea06f6020da43 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sat, 21 Nov 2026 21:25:00 +0800
Subject: [PATCH] clk: hisilicon: add GK6323V100C CRG clock and reset driver

---
 drivers/clk/hisilicon/crg-gk6323v100c.c | 234 ++++++++++++++++++++++++
 1 file changed, 234 insertions(+)
 create mode 100644 drivers/clk/hisilicon/crg-gk6323v100c.c

diff --git a/drivers/clk/hisilicon/crg-gk6323v100c.c b/drivers/clk/hisilicon/crg-gk6323v100c.c
new file mode 100644
index 0000000..3cc8e6b
--- /dev/null
+++ b/drivers/clk/hisilicon/crg-gk6323v100c.c
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * GK6323V100C CRG Clock & Reset Driver
+ * Minimal clock gate + reset controller for GK6323V100C (Hi3798MV200 compatible)
+ */
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/clk-provider.h>
+#include <linux/reset-controller.h>
+#include <linux/bitops.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+#include <linux/spinlock.h>
+
+#define GK_CRG_MAX_GATES	16
+#define GK_CRG_MAX_RESETS	16
+
+struct gk_crg_gate {
+	u32 offset;
+	u8 bit;
+	const char *name;
+};
+
+struct gk_crg_reset {
+	u32 offset;
+	u8 bit;
+	const char *name;
+};
+
+struct gk_crg_priv {
+	void __iomem *base;
+	spinlock_t lock;
+	struct reset_controller_dev rcdev;
+	struct gk_crg_gate gates[GK_CRG_MAX_GATES];
+	struct gk_crg_reset resets[GK_CRG_MAX_RESETS];
+	int num_gates;
+	int num_resets;
+};
+
+/* Initial gates to enable at boot */
+static const struct gk_crg_gate init_gates[] = {
+	{ 0xa0, 0,  "mmc-biu"},
+	{ 0xa0, 1,  "mmc-ciu"},
+	{ 0xb8, 0,  "usb2-0-bus"},
+	{ 0xb8, 1,  "usb2-0-utmi"},
+	{ 0xb8, 2,  "usb2-0-ocp"},
+	{ 0xb8, 3,  "usb2-0-pipe"},
+	{ 0xb8, 4,  "usb2-0-phy"},
+	{ 0xb8, 5,  "usb2-1-bus"},
+	{ 0xb8, 6,  "usb2-1-phy"},
+	{ 0xbc, 0,  "usb2-phy"},
+	{ 0xcc, 0,  "femac-bus"},
+	{ 0xcc, 1,  "femac-mac"},
+	{ 0xcc, 2,  "femac-mdio"},
+	{ 0xd0, 0,  "i2c0"},
+	{ 0x118, 0, "aiao"},
+	{ 0x388, 0, "fephy"},
+};
+
+/* Initial resets: active high (1=assert reset, 0=release reset) */
+static const struct gk_crg_reset init_resets[] = {
+	{ 0xa0, 4,  "mmc"},
+	{ 0xb8, 7,  "usb2-0"},
+	{ 0xb8, 8,  "usb2-1"},
+	{ 0xbc, 1,  "usb2-phy"},
+	{ 0xd0, 3,  "femac"},
+	{ 0xd0, 4,  "femac-mdio"},
+	{ 0x118,1,  "aiao"},
+	{ 0x388,4,  "fephy"},
+	{ 0x200,0,  "i2c0-bus"},
+};
+
+/* Reset controller operations - active high */
+static int gk_crg_reset_assert(struct reset_controller_dev *rcdev, unsigned long id)
+{
+	struct gk_crg_priv *priv = container_of(rcdev, struct gk_crg_priv, rcdev);
+	const struct gk_crg_reset *rst = &priv->resets[id];
+	unsigned long flags;
+	u32 val;
+
+	spin_lock_irqsave(&priv->lock, flags);
+	val = readl(priv->base + rst->offset);
+	val |= BIT(rst->bit);
+	writel(val, priv->base + rst->offset);
+	spin_unlock_irqrestore(&priv->lock, flags);
+	return 0;
+}
+
+static int gk_crg_reset_deassert(struct reset_controller_dev *rcdev, unsigned long id)
+{
+	struct gk_crg_priv *priv = container_of(rcdev, struct gk_crg_priv, rcdev);
+	const struct gk_crg_reset *rst = &priv->resets[id];
+	unsigned long flags;
+	u32 val;
+
+	spin_lock_irqsave(&priv->lock, flags);
+	val = readl(priv->base + rst->offset);
+	val &= ~BIT(rst->bit);
+	writel(val, priv->base + rst->offset);
+	spin_unlock_irqrestore(&priv->lock, flags);
+	return 0;
+}
+
+static int gk_crg_reset_status(struct reset_controller_dev *rcdev, unsigned long id)
+{
+	struct gk_crg_priv *priv = container_of(rcdev, struct gk_crg_priv, rcdev);
+	const struct gk_crg_reset *rst = &priv->resets[id];
+	return !!(readl(priv->base + rst->offset) & BIT(rst->bit));
+}
+
+static int gk_crg_of_xlate(struct reset_controller_dev *rcdev,
+			   const struct of_phandle_args *reset_spec)
+{
+	struct gk_crg_priv *priv = container_of(rcdev, struct gk_crg_priv, rcdev);
+	u32 offset = reset_spec->args[0];
+	u32 bit = reset_spec->args[1];
+	int i;
+
+	for (i = 0; i < priv->num_resets; i++) {
+		if (priv->resets[i].offset == offset && priv->resets[i].bit == bit)
+			return i;
+	}
+	if (priv->num_resets < GK_CRG_MAX_RESETS) {
+		priv->resets[priv->num_resets].offset = offset;
+		priv->resets[priv->num_resets].bit = bit;
+		priv->resets[priv->num_resets].name = "dynamic";
+		return priv->num_resets++;
+	}
+	return -EINVAL;
+}
+
+static const struct reset_control_ops gk_crg_reset_ops = {
+	.assert = gk_crg_reset_assert,
+	.deassert = gk_crg_reset_deassert,
+	.status = gk_crg_reset_status,
+};
+
+static int gk_crg_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct gk_crg_priv *priv;
+	void __iomem *base;
+	int i, ret;
+	u32 val;
+
+	base = devm_of_iomap(dev, dev->of_node, 0, NULL);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->base = base;
+	spin_lock_init(&priv->lock);
+
+	/* Enable clock gates */
+	for (i = 0; i < ARRAY_SIZE(init_gates); i++) {
+		val = readl(base + init_gates[i].offset);
+		val |= BIT(init_gates[i].bit);
+		writel(val, base + init_gates[i].offset);
+		priv->gates[i] = init_gates[i];
+	}
+	priv->num_gates = ARRAY_SIZE(init_gates);
+
+	/* Assert all resets first */
+	for (i = 0; i < ARRAY_SIZE(init_resets); i++) {
+		val = readl(base + init_resets[i].offset);
+		val |= BIT(init_resets[i].bit);
+		writel(val, base + init_resets[i].offset);
+		priv->resets[i] = init_resets[i];
+	}
+	priv->num_resets = ARRAY_SIZE(init_resets);
+	mdelay(10);
+
+	/* Release all resets (clear bits) */
+	for (i = 0; i < ARRAY_SIZE(init_resets); i++) {
+		val = readl(base + init_resets[i].offset);
+		val &= ~BIT(init_resets[i].bit);
+		writel(val, base + init_resets[i].offset);
+	}
+	mdelay(50);
+
+	/* Register reset controller */
+	priv->rcdev.owner = THIS_MODULE;
+	priv->rcdev.ops = &gk_crg_reset_ops;
+	priv->rcdev.of_node = dev->of_node;
+	priv->rcdev.of_reset_n_cells = 2;
+	priv->rcdev.of_xlate = gk_crg_of_xlate;
+	priv->rcdev.nr_resets = GK_CRG_MAX_RESETS;
+
+	ret = devm_reset_controller_register(dev, &priv->rcdev);
+	if (ret) {
+		dev_err(dev, "Failed to register reset controller: %d\n", ret);
+		return ret;
+	}
+
+	dev_info(dev, "GK6323V100C CRG: %d gates enabled, %d resets released (active high, cells=2)\n",
+		 priv->num_gates, priv->num_resets);
+	return 0;
+}
+
+static const struct of_device_id gk_crg_of_match[] = {
+	{ .compatible = "goke,gk6323v100c-crg" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, gk_crg_of_match);
+
+static struct platform_driver gk_crg_driver = {
+	.probe = gk_crg_probe,
+	.driver = {
+		.name = "gk6323v100c-crg",
+		.of_match_table = gk_crg_of_match,
+	},
+};
+
+static int __init gk_crg_init(void)
+{
+	return platform_driver_register(&gk_crg_driver);
+}
+arch_initcall_sync(gk_crg_init);
+
+static void __exit gk_crg_exit(void)
+{
+	platform_driver_unregister(&gk_crg_driver);
+}
+module_exit(gk_crg_exit);
+
+MODULE_LICENSE("GPL v2");
+MODULE_AUTHOR("GK6323 Mainline Port");
+MODULE_DESCRIPTION("GK6323V100C CRG Clock and Reset Driver");
-- 
2.34.1

