# ============================================================
# GK6323V100C（国科微，真机实测：4×Cortex-A55 + GICv3，ARM64）
# 单板配置叠加层
#
# 目标：在主线 arm64 内核上，为这台盒子编出能启动、且**支持 USB 声卡**
# 的内核与模块，产物形态与 hi3798mv100 仓库一致（内核 + 模块）。
#
# 重要更正（此前判断有误）：
# 早前把本机当成"硅片等同海思 Hi3798MV200H（4×A53 + GIC-400）"，
# 这是错的。真机导出的设备树与 /proc/cpuinfo 都表明是
# 4×Cortex-A55（CPU part 0xd05） + arm,gic-v3 + 国科私有 CRU。
# 因此设备树不能用海思 mv200 的板级 dts，本仓库改用自己的
# dts/gk6323v100c-chaoge-z71a.dts（逐项取自真机）。
# 配置层也随之只保留"主线已有、且真机会用到"的驱动。
#
# 用法：
# make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- defconfig
# ./scripts/kconfig/merge_config.sh -m .config kernel.config
# make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
#
# 为什么做成叠加层、而不是直接放一份整份 .config：
# 本内核树是 arm64 通用树 + histb 补丁。整份旧配置喂给 olddefconfig，
# 会把补丁新增、而本配置未覆盖的符号悄悄留成 n，排查困难。
# 所以先取 arm64 默认配置（已含 GICv3、A55、PL011、PL061、PL022、
# dw-mshc、hix5hd2-i2c、sp805 等），再叠加本文件补差异项。
#
# 两条书写纪律（都直接决定 CI 里的「叠加层逐行自检」是否报未生效）：
# A) 父菜单符号必须写在子符号之前，本文件里以 ★ 标出。
# 例：CMDLINE_PARTITION 的 prompt 条件是 "if PARTITION_ADVANCED"，
# 父项为 n 时它成了「无 prompt 符号」，写进来的值会被 olddefconfig
# 直接丢弃 —— 于是构建在「必须项」一节中止。
# 同理：HISI_FEMAC 在 "if NET_VENDOR_HISILICON" 内，NLS_CODEPAGE_* 在
# "if NLS" 内，PHY_HISI_INNO_USB2 在 GENERIC_PHY / USB_PHY 之下。
# B) **无 prompt 符号一律不写进本文件**。Kconfig 里只有 `config X` 而没有
# 提示字符串的符号，取值只由 default / select 决定，fragment 与
# scripts/config 都改不动它；写进来只会在自检里报「未生效」，属误报。
# 本文件不写哪些、为什么，见文末附录。
#
# 不再使用自定义的 CONFIG_COMMON_CLK_GK6323V100C
#
# 2026-11-24 修订：删除 CONFIG_COMMON_CLK_HI3798MV200=y 一行。
# 该符号在 drivers/clk/hisilicon/Kconfig 里是 tristate 且 default ARCH_HISI，
# ARCH_HISI=y 时默认就是 y；而工作流为避免其驱动 crg-hi3798mv200.c 依赖的
# PLL 注册接口（对应补丁已跳过）编译失败，会显式 --disable 它。两边对着写，
# 结果就是构建日志里那条「叠加层未生效：CONFIG_COMMON_CLK_HI3798MV200=y」。
# 本机外设时钟由设备树 fixed-clock + bootargs 的 clk_ignore_unused 维持，
# 配合工作流注入的自写 CRG 驱动，不依赖这个符号。
# ============================================================

# --- 平台骨架 ---
CONFIG_ARCH_HISI=y
CONFIG_OF=y

# --- 中断控制器：真机是 GICv3（GICD@0xf1000000 / GICR@0xf1040000），
# 不是 GIC-400。arm64 默认配置已含，这里显式写出以防被裁剪。---
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
# 注：ARM_GIC_V3_ITS 是**无 prompt 符号**（取值只由 PCI / default 决定），
# fragment 里写 =n 也会被 olddefconfig 重算（实测仍是 y），故不写。
# 本板真机设备树里没有 ITS 节点，它为 y 也不会被 probe，不影响启动。
# 详见文末「附录：本文件不写的三类符号」。

# --- 定时器：armv8 arch timer，24MHz ---
CONFIG_ARM_ARCH_TIMER=y

# --- 时钟 / 复位 ---
CONFIG_COMMON_CLK=y
CONFIG_RESET_CONTROLLER=y
# 注：真机的 CRU 是国科私有 "goke,gk6323v100c-cru"，主线无驱动。
# 本版不走它：设备树里把各外设时钟改指 fixed-clock，配合
# bootargs 的 clk_ignore_unused，由 bootloader 保持时钟上电。
# 国科 CRU 驱动（若日后写出）再单独加符号，此处不写。

# --- 串口：TTL 控制台 console=ttyAMA0（CONSOLE 挂在 PL011 之下）---
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# 早期控制台：内核解压后立刻输出，不必等 PL011 驱动 probe。
# ★ 主线内核**没有** CONFIG_SERIAL_AMBA_PL011_EARLYCON 这个符号（那是 8250 系列
# 的命名风格）。PL011 的 earlycon 由 amba-pl011.c 中的
# OF_EARLYCON_DECLARE(pl011, "arm,pl011", pl011_early_console_setup)
# 注册，只受 CONFIG_SERIAL_EARLYCON 一个开关控制；命令行写
# earlycon=pl011,mmio32,0xf8b00000
# 即可（地址取自本文件设备树 uart0 的 reg）。
# 2026-11-19 那版写了 SERIAL_AMBA_PL011_EARLYCON=y，内核树里查无此符号，
# 被 olddefconfig 直接丢弃 —— 构建日志「叠加层未生效」那一条就是它。
CONFIG_SERIAL_EARLYCON=y

# --- 存储：eMMC。真机 compatible 是国科私有 gk6323v100c-dw-mshc，
# 主线无此驱动，设备树里已追加 "snps,dw-mshc" 让其被
# dw_mmc-pltfm 认领，因此这里开 MMC_DW_PLTFM 即可。---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_EXT4_FS=y

# --- 分区表：本机 root= 与全部 18 个分区都由 bootargs 里的 blkdevparts=
# 下发，少了这一项内核看不到 mmcblk0p18，直接起不来 ---
# ★ 父符号：CMDLINE_PARTITION 的 prompt 条件是 "if PARTITION_ADVANCED"
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_CMDLINE_PARTITION=y

# --- 网络：板载百兆 femac（真机 compatible = hisilicon,hisi-femac-v2）---
# ★ 父符号：HISI_FEMAC 在 "if NET_VENDOR_HISILICON" 内，还依赖 PHYLIB。
# 不先开这两个父项，MAC 会被丢弃、网口起不来。
# ★ OF_MDIO 是 MDIO_HISI_FEMAC 的父项（依赖 OF 与 PHYLIB）。MDIO 总线驱动
# 是本板设备树 mdio@f9c31100 节点（compatible "hisilicon,hisi-femac-mdio"）
# 的驱动，少写它，PHY 永远挂不上总线，MAC 起来了也没有 PHY、网口不通。
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PHYLIB=y
CONFIG_OF_MDIO=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_HISI_FEMAC=y
CONFIG_MDIO_HISI_FEMAC=y
CONFIG_IPV6=y
# CONFIG_HISI_FESTA_PHY 已从本文件移除（2026-11-18）：
# 补丁库 rc3 版重构清单后，整库 126 个补丁里已没有任何 Festa PHY 驱动补丁
# （旧库那个 pending-7.4/210-01-...-festa-phys.patch 在重构后消失）。也就是说
# 7.4-rc3 内核树里根本没有这个符号，写进来会被 olddefconfig 丢弃，CI 会报
# 「未生效」——那不是写法问题，是符号不存在。
# ★ 判别方法：符号若存在于树里，即使被关掉，.config 里也会有
# "# CONFIG_XXX is not set" 这一行；一行都没有，就是树里没这个符号。
# 等驱动回到补丁库、或改用 hisi-femac 自带 PHY / 固定链路方案后再启用。

# --- I2C：真机 3 路，compatible = hisilicon,hix5hd2-i2c（主线自带）---
CONFIG_I2C=y
CONFIG_I2C_HIX5HD2=y

# --- GPIO：真机 8 路 PL061 ---
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y

# --- SPI：真机 1 路 PL022 ---
CONFIG_SPI=y
CONFIG_SPI_PL022=y

# --- RTC：真机 I2C2 上挂 nxp,pcf8563 ---
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PCF8563=y

# --- 看门狗：SP805，同时也是这颗 SoC 的复位通道（panic 后靠它重启）---
CONFIG_WATCHDOG=y
CONFIG_ARM_SP805_WATCHDOG=y

# --- 启动画面：本版不开 FB ---
# 原先是 CONFIG_FB=y + CONFIG_FB_SIMPLE=y，想接管 bootloader 设好的线性帧缓冲。
# 但本机第一阶段没有主线显示驱动、设备树里也没有 simple-framebuffer 节点，
# 控制台走串口 PL011；而裁剪层写的是 `# CONFIG_FB is not set`，两边正好互相
# 矛盾（谁生效只看文件顺序）。现统一为「不开」，与裁剪层一致，也省下一笔体积。
# 要恢复显示时：把下面两行的注释去掉，并删掉 slim.config 里的
# `# CONFIG_FB is not set`（否则流水线的分层纪律自检会直接中止构建）。
# CONFIG_FB=y
# CONFIG_FB_SIMPLE=y

# --- USB 主控：真机只有 EHCI / OHCI（无 xhci）---
# ★ 父符号：PHY_HISI_INNO_USB2 在 GENERIC_PHY / USB_PHY 之下，必须先写。
CONFIG_USB=y
CONFIG_GENERIC_PHY=y
CONFIG_USB_PHY=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_HISI_INNO_USB2=y
CONFIG_USB_STORAGE=y

# --- 声音 1/2：ALSA 骨架（只写有 prompt 的骨架项）---
CONFIG_SOUND=y
CONFIG_SND=y
# 注：SND_PCM、SND_TIMER、SND_HWDEP、SND_RAWMIDI 都是**无 prompt 符号**，
# 取值只由 select 决定（USB 音频驱动 select SND_PCM 等），fragment 里
# 写 =y 或 =m 都会被 olddefconfig 重算，故一律不写。
# 实际取值随 SND_USB_AUDIO 的 tristate 等级走：USB 音频是 m，它们就是 m，
# 功能完全正常 —— 早前把它们写成本文件、自检报"未生效"，就是这一类误报。
# 它们的实际取值看流水线里的「派生符号报告」一节。

# --- 声音 2/2：★ 本仓库存在的理由 —— USB 声卡 / USB DAC / USB 麦克风 ---
# 形态与 mv100 的 kernel.config 完全一致：核心 =y，驱动本身 =m。
# 因此刷完内核还必须解开 modules.tar.gz，否则 snd-usb-audio 不在机器上。
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
#
# ★ 要让上面的 =m 真正生效，CI 里对应的那一行必须是
# scripts/config --module SND_USB_AUDIO （--module 才是设成 m）
# 若写成 scripts/config --enable SND_USB_AUDIO，对 tristate 符号等于设成 y，
# 这一行会被顶掉、编成内置，模块包里也就没有 snd-usb-audio.ko 了。

# --- 模块支持：作者那版是纯内置内核（/proc/modules 不存在，insmod 用不了）---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- 可移动存储与中文文件名 ---
# ★ 父符号：NLS_CODEPAGE_* / NLS_UTF8 都在 "if NLS" 内，不先开 NLS 三项全丢。
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_UTF8=y
# --- NFS v3 客户端（2026-11-24 切换：放弃 CIFS，走 NFS v3 挂载 NAS 音乐目录）
# 本机作客户端只用到 NFS v3（TCP + nolock 避开 NLM/statd 依赖），NFSD 服务端不需要。
# SUNRPC / LOCKD / NFS_COMMON 均为无 prompt 符号，由 NFS_FS / NFS_V3 自动 select，
# 不写进本文件（参见文末附录 1）。
CONFIG_NFS_FS=m
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y

# --- 启动参数：内核自带一份，并强制使用它（CMDLINE_FORCE）---
# 内核的 cmdline 有两个来源：
# (a) 引导器通过设备树 /chosen/bootargs 传进来（还可能被 U-Boot 用环境变量
# 的 bootargs 覆盖，谁赢取决于 U-Boot 编译时的 force 参数）
# (b) 内核内置的 CONFIG_CMDLINE
# 本机实测无法确证 (a)：bootcmd 是 `bootm 0x04000000`，**没有第三个 fdt 参数**，
# 而 U-Boot 打印的是 "ATAGS [0x00000100 - 0x000005E0], 1248Bytes" 而不是
# "using: FDT"。arm64 必须靠设备树启动，一旦内核拿到的是 ATAGS 地址，
# 它会在 early_init_dt_verify() 里校验 magic 失败，连 console 都来不及建立
# 就挂住 —— 串口一个字都没有，正是 2026-11-19 的现象。
# arm64 没有 CMDLINE_EXTEND（见 slim.config 第 3 节），
# * FROM_BOOTLOADER 只能沿用引导器那份，引导器不给 earlycon 就永远没有早期输出；
# * FORCE 则由 drivers/of/fdt.c: early_init_dt_scan_chosen() **无条件**覆盖，
# 只要内核拿到合法设备树就生效。
# 所以带板阶段先用 FORCE，把「早期串口输出」这件事变成确定的。
# 代价两条，都写在 README「已知限制」里：
# 1) 以后「单刷 dtbo 分区换 rootfs」的玩法会失效（root= 由内核定死在这份参数里）；
# 2) FORCE 的前提仍是内核拿到合法 fdt —— 拿不到时这一行也用不上。
# 进系统后再改回 FROM_BOOTLOADER（把本行与 FORCE 行删掉即可）。
# ★ 不带 mem= 限制：真机内存是 2GiB（真机导出的设备树 memory@0 = 0x80000000，
# /proc/meminfo 的 MemTotal 2018984 kB 与之吻合）。U-Boot 打印的 "1 GiB" 是
# 它自己的映射上限，不是硬件容量，别照它写 mem=1G。
CONFIG_CMDLINE="earlycon=pl011,mmio32,0xf8b00000,115200n8 console=ttyAMA0,115200n8 console=tty0 clk_ignore_unused net.ifnames=0 root=/dev/mmcblk0p18 rootfstype=ext4 rootwait rw panic=-1 blkdevparts=mmcblk0:1M(fastboot),512K(bootargs),512K(bootargsbak),20M(recovery),2M(deviceinfo),8M(securestore),2M(atf),8M(baseparam),8M(pqparam),2M(dtbo),10M(logo),10M(logobak),20M(fastplay),20M(recoverybak),60M(boot),20M(misc),20M(trustedcore),-(rootfs)"
CONFIG_CMDLINE_FORCE=y

# --- 构建姿态：换 -Os 并关调试符号，直接缩小 Image ---
# 默认 -O2 编出的 Image 更大；这台盒子上 -Os 与 -O2 的性能差异无关紧要，
# 体积收益大约一成。
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_DEBUG_INFO_NONE=y
# ★ EXPERT 只做一件事：给一批"专家项"解锁提示字符串，本身不改变任何默认值。
# 加它的唯一理由是 KALLSYMS —— init/Kconfig 里写的是
# bool "Load all symbols for debugging/ksymoops" if EXPERT
# 没有 EXPERT 时它没有提示字符串，裁剪层那句
# # CONFIG_KALLSYMS is not set
# 会被 olddefconfig 直接丢弃，等于白写。符号表实测约占 1.8MB，
# 关掉它是把这台机器压进 U-Boot 体积上限的最大一笔。
CONFIG_EXPERT=y

# --- 与裁剪层配对使用的启用项（裁剪层只写「关」，另一半必须写在这里）---
# ★ 2026-11-24：systemd 必需的 cgroup 控制器（cgroup v2 统一层级）。
# 裁剪层不再关闭它们；这里显式声明，好让「叠加层逐行自检」逐条核对。
# 只保留 CONFIG_CGROUPS 本体远远不够：缺下面这些控制器时，systemd 无法把
# 服务进程放进 cgroup，会以 219/CGROUP 失败，症状为
#   Failed to attach to cgroup …: No medium found
#   Failed at step CGROUP spawning …
# 于是【任何】服务都起不来（不只是 LMS）。父项 CONFIG_CGROUPS 由 arm64
# 默认配置给出 =y，本文件与裁剪层都不动它。
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
# 地址空间：2GiB 内存用 39 位虚拟地址足够，页表更小；4K 页 + 48 位物理地址。
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_ARM64_4K_PAGES=y
# 勘误 workaround：真机 CPU 是 Cortex-A55（CPU part 0xd05，见真机 /proc/cpuinfo），
# arch/arm64/Kconfig:734 写明 ARM64_ERRATUM_2441007 就是这颗核的：
# "Cortex-A55: Completion of affected memory accesses might not be
# guaranteed by completion of a TLBI (rare)"
# 2026-11-19 那版误以为它属于 Neoverse-N1 而删掉，方向反了 —— 它是 A55 专属，
# 关掉等于给自己这颗核挖坑。这里按真机显式打开（此符号有 prompt，可以写）。
CONFIG_ARM64_ERRATUM_2441007=y
# 带板调试：读 /sys/kernel/debug/clk/clk_summary 查 eMMC / CRU 时钟要走 debugfs。
# （它依赖的 DEBUG_KERNEL 在 arm64 默认配置里就是 =y，本文件与裁剪层都不动它。）
CONFIG_DEBUG_FS=y
# 网口：PHY 挂在 MDIO 总线上。★ 注意 **MII 不能写在这里**：
# drivers/net/Kconfig 里它是 `config MII` + 单独一行 `tristate`，没有提示字符串，
# 属无 prompt 符号，取值由 PHYLIB 等 select 决定。写 =y 会被 olddefconfig 丢弃，
# 只在自检里刷一条「未生效」——2026-11-19 那版就为此报了两条同样的误报。
# 它的实际取值看流水线「派生符号报告」一节。
# FAT/NTFS 的名字编码：iocharset=utf8 + codepage 936，与上面打开的
# NLS_CODEPAGE_936 / NLS_UTF8 配套；MSDOS_FS / VFAT_FS 已在上面打开。
# 再补一个 NLS_ISO8859_1：有些工具会显式按 iso8859-1 挂 U 盘，缺了会
# 报 "iocharset not found"，而它只有几 KB。
CONFIG_NLS_ISO8859_1=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FAT_DEFAULT_CODEPAGE=936
# U 盘 NTFS 支持：用**模块**（=m）。模块不进 Image，对 U-Boot 那道体积上限
# 零影响，却能让 NTFS 分区可挂载；裁剪层不得再写
# `# CONFIG_NTFS3_FS is not set`（那样两层就抢同一个符号了）。
CONFIG_NTFS3_FS=m

# ============================================================
# 附录：本文件不写的四类符号
#
# 另有一条总规矩：**本文件只写「开」，一切「关」都写在 slim.config**，
# 两层不许出现同一个符号。流水线的「配置分层纪律自检」把这条钉死
# （slim.config 出现 =y/=m、本文件出现 `# CONFIG_X is not set`、或两层
# 符号重叠，都直接中止构建）。2026-11-19 那次构建失败就是两层互抢符号。
#
# 1) 无 prompt 符号（Kconfig 里只有 `config X` / `tristate`，没有提示字符串）
# 典型：ARM_GIC_V3_ITS、SND_PCM、SND_TIMER、SND_HWDEP、SND_RAWMIDI、
# SND_SOC、MDIO_DEVICE、USB_COMMON、MII 等。
# MII 就是 2026-11-19 那版连报两条的那一项（drivers/net/Kconfig 里
# `config MII` 下面只有一行 `tristate`，没有提示串）。
# 取值只由 default / select 决定，fragment 与 scripts/config 都改不动，
# 写进来只会在「叠加层逐行自检」里报「未生效」——是**误报**。
# 要看它们实际是什么，看流水线的「派生符号报告」一节。
#
# 2) 由父菜单 if 包住、而父项没开的符号
# 见上文 ★ 标注的四处。写法：父在前、子在后。
#
# 3) 内核树里根本不存在的符号（补丁库移除、改名，或依赖未满足）
# 判别方法：符号存在于树里时，即使被关掉，.config 里也会有
# "# CONFIG_XXX is not set" 这一行；**一行都没有**，就是树里没这个符号。
# 典型：HISI_FESTA_PHY —— 补丁库 rc3 版已移除提供它的那个补丁，故本文件
# 不再写它（见上文网络一节）。流水线在报未生效时会自动打印该符号在本次
# 内核树里的 Kconfig 定义（含依赖），据此判断该补父项、还是该删掉这行。
#
# 4) int / hex / string 型符号（只能写 `CONFIG_X=数值` 或 `CONFIG_X="串"`）
# 写成 `# CONFIG_X is not set` 会被 merge_config 译成 `CONFIG_X=n`，
# Kconfig 随即报
# .config:NNNN:warning: symbol value 'n' invalid for X
# 典型：CONFIG_FRAME_WARN（int）。2026-11-19 的裁剪层就把
# `# CONFIG_FRAME_WARN is not set` 写了进去，于是冒出这条警告。
# 要调阈值就写数值（如 CONFIG_FRAME_WARN=2048），不写就用内核默认
# （64 位为 2048）。本文件与裁剪层现在都不写它。
# ============================================================
