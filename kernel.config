# ============================================================
# GK6323V100C（国科微，真机实测：4×Cortex-A55 + GICv3，ARM64）
# 单板配置叠加层
# ============================================================
# --- 平台骨架 ---
CONFIG_ARCH_HISI=y
CONFIG_OF=y
# --- 中断控制器：真机是 GICv3（GICD@0xf1000000 / GICR@0xf1040000），不是 GIC-400。---
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y

# --- 定时器：armv8 arch timer，24MHz ---
CONFIG_ARM_ARCH_TIMER=y

# --- 时钟 / 复位 ---
CONFIG_COMMON_CLK=y
CONFIG_RESET_CONTROLLER=y

# --- cgroup v2（systemd 257 必需：它已移除 cgroup v1 支持，只认统一层级）---
# ★ 没有 CONFIG_CGROUPS_V2 这个符号。7.4-rc3 树自带的
#   Documentation/admin-guide/cgroup-v2.rst 只要求 `mount -t cgroup2 none <挂载点>`；
#   参考仓库 hi3798mv100 那份「能正常工作」的完整 .config 里也是 CGROUPS=y + 下面这些
#   控制器本体，通篇没有 CGROUPS_V2。这棵树把 v1 兼容拆成每控制器可选的
#   MEMCG_V1 / CPUSETS_V1，默认就是关的 —— 那是 v1 开关，不是 v2 开关。
#   真正必须齐的是控制器本体：少一个，所有服务启动即报 status=219/CGROUP。
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
# ★ 对齐可工作样本（mv100 的 .config 里这几项都是 y）：
#   PSI 供 systemd 做压力统计；BPF_SYSCALL 是 CGROUP_BPF 的父符号（父在前），
#   缺 CGROUP_BPF 时 systemd 会刷 "does not support BPF/cgroup firewalling" 警告。
CONFIG_PSI=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# --- 串口：TTL 控制台 console=ttyAMA0 ---
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- 存储：eMMC ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_EXT4_FS=y

# --- 分区表 ---
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_CMDLINE_PARTITION=y

# --- 网络：板载百兆 femac ---
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PHYLIB=y
CONFIG_OF_MDIO=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_HISI_FEMAC=y
CONFIG_MDIO_HISI_FEMAC=y
CONFIG_IPV6=y

# --- I2C：真机 3 路，compatible = hisilicon,hix5hd2-i2c ---
CONFIG_I2C=y
CONFIG_I2C_HIX5HD2=y

# --- GPIO：真机 8 路 PL061 ---
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y

# --- SPI：真机 1 路 PL022 ---
CONFIG_SPI=y
CONFIG_SPI_PL022=y

# --- RTC：真机 I2C2 上挂 nxp,pcf8563 ---
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PCF8563=y

# --- 看门狗：SP805，复位通道 ---
CONFIG_WATCHDOG=y
CONFIG_ARM_SP805_WATCHDOG=y

# --- USB 主控：真机只有 EHCI / OHCI（无 xhci）---
CONFIG_USB=y
CONFIG_GENERIC_PHY=y
CONFIG_USB_PHY=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_HISI_INNO_USB2=y
CONFIG_USB_STORAGE=y

# --- 声音：ALSA 骨架 + ES8316 板载声卡 + USB 声卡 ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ES8316=y
CONFIG_SND_SOC_HISTB_AIAO_I2S=y
CONFIG_SND_SOC_HISTB_AIAO_CARD=y
CONFIG_SND_SIMPLE_CARD=y

# --- 模块支持 ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- 可移动存储与中文文件名 + NFS v3 客户端（CIFS 已移除）---
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FAT_DEFAULT_CODEPAGE=936
CONFIG_NTFS3_FS=m
CONFIG_NFS_FS=m
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y

# --- 启动参数 ---
CONFIG_CMDLINE="earlycon=pl011,mmio32,0xf8b00000,115200n8 console=ttyAMA0,115200n8 console=tty0 clk_ignore_unused net.ifnames=0 root=/dev/mmcblk0p18 rootfstype=ext4 rootwait rw panic=-1 blkdevparts=mmcblk0:1M(fastboot),512K(bootargs),512K(bootargsbak),20M(recovery),2M(deviceinfo),8M(securestore),2M(atf),8M(baseparam),8M(pqparam),2M(dtbo),10M(logo),10M(logobak),20M(fastplay),20M(recoverybak),60M(boot),20M(misc),20M(trustedcore),-(rootfs)"
CONFIG_CMDLINE_FORCE=y

# --- 构建姿态：换 -Os 缩体积 ---
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_EXPERT=y

# --- 地址空间与勘误 ---
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_ERRATUM_2441007=y
CONFIG_DEBUG_FS=y
