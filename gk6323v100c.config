# ============================================================
# GK6323V100C（国科微，硅片等同海思 Hi3798MV200H / MV310，ARM64）
# 单板配置叠加层
#
# 目标：在 histb 主线内核上，为这台盒子编出能启动、且**支持 USB 声卡**
#       的内核与模块。与 hi3798mv100 那套的实质差别，就是最后那三行
#       CONFIG_SND_USB*：作者那版 BSP 内核没编入它们，USB 声卡因此不出声。
#
# 用法：
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- defconfig
#   ./scripts/kconfig/merge_config.sh -m .config gk6323v100c.config
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
#
# 为什么做成叠加层、而不是像 mv100 那样直接放一份整份 .config：
#   本内核树是 arm64 通用树 + histb 补丁，补丁新增的驱动符号
#   （COMMON_CLK_HI3798MV200、PINCTRL_HISTB、SND_SOC_HISTB_AIAO_CARD …）
#   要打完补丁后才在 Kconfig 里可见。整份旧配置喂给 olddefconfig，
#   这些新符号会被悄悄留成 n。所以先取 arm64 默认配置，再叠加本文件。
#
# 书写顺序有讲究：kconfig 按行顺序算可见性，父符号要写在子符号之前。
# ============================================================

# --- 平台骨架 ---
CONFIG_ARCH_HISI=y
CONFIG_USE_OF=y

# --- 时钟 / 复位（COMMON_CLK_HI3798MV200 由补丁库新增）---
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_HI3798MV200=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_HISI=y

# --- pinctrl（由补丁库新增）---
CONFIG_PINCTRL=y
CONFIG_PINCTRL_HISTB=y
CONFIG_PINCTRL_HI3798MV2X=y

# --- 串口：TTL 控制台 console=ttyAMA0 ---
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- 存储：eMMC（compatible = hisilicon,hi3798cv200-dw-mshc）与根文件系统 ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_HI3798CV200=y
CONFIG_EXT4_FS=y

# --- 分区表：本机 root= 与全部 18 个分区都由 bootargs 里的 blkdevparts= 下发，
#     少了这一项内核看不到 mmcblk0p18，直接起不来 ---
CONFIG_CMDLINE_PARTITION=y

# --- 网络：板载百兆 femac ---
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_HISI_FEMAC=y
CONFIG_HISI_FESTA_PHY=y

# --- USB 主控：本板设备树里 xhci 是注释掉的，只有 EHCI / OHCI ---
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_HISI_INNO_USB2=y
CONFIG_USB_STORAGE=y

# --- 声音 1/3：ALSA 骨架 ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y

# --- 声音 2/3：板载音频（Histb AIAO 走 I2S / ES8316 那一路，由补丁库新增）---
CONFIG_SND_SOC_HISTB_AIAO_I2S=y
CONFIG_SND_SOC_HISTB_AIAO_CARD=y

# --- 声音 3/3：★ 本仓库存在的理由 —— USB 声卡 / USB DAC / USB 麦克风 ---
# 形态与 mv100 的 kernel.config 完全一致：核心 =y，驱动本身 =m。
# 因此刷完内核还必须解开 modules.tar.gz，否则 snd-usb-audio 不在机器上。
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m

# --- 模块支持：作者那版是纯内置内核（/proc/modules 不存在，insmod 用不了）---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- 可移动存储与中文文件名 ---
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_UTF8=y

# --- 启动参数交给 bootargs 分区传，不在内核里写死 root= ---
CONFIG_CMDLINE=""

# --- 构建姿态：关调试符号，缩小 vmlinux（boot 分区只有 60M）---
CONFIG_DEBUG_INFO_NONE=y
