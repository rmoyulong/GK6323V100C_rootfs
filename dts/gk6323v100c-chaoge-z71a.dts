// SPDX-License-Identifier: GPL-2.0+
/*
 * 国科微 GK6323V100C（整机型号 ChaoGe Z71A）板级设备树 —— 引导最小集
 *
 * 数据来源：真机原厂内核导出的 /sys/firmware/devicetree/base，逐项对齐，
 * 没有臆造参数。真机实测为 4×Cortex-A55（part 0xd05）+ GICv3 + 国科私有 CRU，
 * 不是海思的 A53 + GIC-400，所以本文件不是海思 mv200h 板级的照抄。
 *
 * 为什么只有这些节点 —— 引导器读了 16KiB 就收手：
 *   U-Boot 的 bootcmd 是
 *     mmc read 0 0x03FFC000 0x19000 0x20
 *   即从 dtbo 分区（起始块 0x19000）只读 0x20 = 32 块 = 16KiB 到 0x03FFC000，
 *   这个地址紧贴内核加载地址 0x04000000 之下。设备树超过 16KiB 就会被截断，
 *   内核解析失败 → 起不来。作者那版 dtbo 里的 dtb 只有 9156 字节。
 *   所以本文件只保留「点亮系统所必需」的节点，其余一律不写：
 *     串口控制台(uart0) / eMMC / 复位看门狗 / USB 主控 / 网口 / RTC
 *
 * 本次相对上一版删掉的（引导用不到，需要时再加回来）：
 *   GPIO×8（PL061，无任何消费者）、uart2、uart3、i2c0、i2c1、spi0、
 *   chosen 下的 simple-framebuffer、vdp 保留内存，
 *   aliases 中除 serial0 以外的全部别名，以及根 compatible 的第三串。
 *
 * 与真机原树的有意差异（让主线内核能认领硬件）：
 *   1) eMMC 的 compatible 追加 "snps,dw-mshc"，使主线 dw_mmc-pltfm 能够认领
 *      （原 compatible 是国科 BSP 私有名，主线无此驱动）；
 *   2) 各外设时钟改指下面的 fixed-clock，不再引用国科私有 CRU —— 主线没有
 *      该 CRU 驱动，继续引用会让外设 probe 时永久 -EPROBE_DEFER；
 *   3) 真机树里主线无驱动的节点（aiao 音频、cpufreq、thermal、ir、cru）不写。
 *
 * 中断 specifier：GICv3 为 3 个 cell = <类型 号 触发方式>，类型 0=SPI、1=PPI，
 * 号是 GIC 视角的号（SPI 号 = 真机 /proc/interrupts 里的号 - 32）。
 */

/dts-v1/;

/ {
	model = "ChaoGe Z71A (GK6323V100C) ARM64";
	compatible = "chaoge,z71a", "goke,gk6323v100c";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	/* stdout-path = "serial0:..." 依赖这条别名，其余别名引导用不到 */
	aliases {
		serial0 = &uart0;
	};

	chosen {
		/* 与 bootargs 分区一致；root= 亦由此下发 */
		bootargs = "console=ttyAMA0,115200n8 console=tty0 clk_ignore_unused net.ifnames=0 root=/dev/mmcblk0p18 rootfstype=ext4 rootwait rw panic=-1 blkdevparts=mmcblk0:1M(fastboot),512K(bootargs),512K(bootargsbak),20M(recovery),2M(deviceinfo),8M(securestore),2M(atf),8M(baseparam),8M(pqparam),2M(dtbo),10M(logo),10M(logobak),20M(fastplay),20M(recoverybak),60M(boot),20M(misc),20M(trustedcore),-(rootfs)";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x80000000>;
	};

	/* BL31(ATF) 与 OPTEE 占用区，必须告知内核，否则会被当作可用内存 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bl31@8020000 {
			reg = <0x00 0x8020000 0x00 0x200000>;
			no-map;
		};

		optee@d200000 {
			reg = <0x00 0xd200000 0x00 0x400000>;
			no-map;
		};
	};

	/* 国科 CRU 无主线驱动，外设时钟一律用固定时钟，由 bootloader 保持上电 */
	clocks {
		clk_24m: clk-24m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
		};

		clk_50m: clk-50m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <50000000>;
		};

		clk_75m: clk-75m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <75000000>;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0>;
			enable-method = "psci";
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	/* A55 的 arch timer：4 个 PPI，频率 24MHz（与真机一致） */
	timer {
		compatible = "arm,armv8-timer";
		interrupts = <1 13 4>, <1 14 4>, <1 11 4>, <1 10 4>;
		clock-frequency = <24000000>;
	};

	gic: interrupt-controller@f1000000 {
		compatible = "arm,gic-v3";
		reg = <0x0 0xf1000000 0x0 0x10000>,
		      <0x0 0xf1040000 0x0 0x80000>;
		interrupt-controller;
		#interrupt-cells = <3>;
	};

	soc: soc@f0000000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges = <0xf0000000 0x0 0xf0000000 0x10000000>;

		/* 控制台串口：bootargs 的 console=ttyAMA0 指这里 */
		uart0: serial@f8b00000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0xf8b00000 0x1000>;
			interrupts = <0 49 4>;
			clocks = <&clk_75m>, <&clk_75m>;
			clock-names = "uartclk", "apb_pclk";
		};

		/* 板载 RTC：PCF8563 挂在 i2c2 上，地址 0x51 */
		i2c2: i2c@f8b12000 {
			compatible = "hisilicon,hix5hd2-i2c";
			reg = <0xf8b12000 0x1000>;
			interrupts = <0 40 4>;
			clocks = <&clk_50m>;
			clock-names = "apb_pclk";
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			rtc@51 {
				compatible = "nxp,pcf8563";
				reg = <0x51>;
			};
		};

		/*
		 * eMMC：根文件系统在 mmcblk0p18，本项必须起来。
		 * 第二段 reg 是国科 CRU 里那 0x40 字节的 SD 时钟控制寄存器，保留原位，
		 * 主线驱动不会去动它（时钟由 bootloader 保持上电）。
		 */
		emmc: mmc@f9830000 {
			compatible = "goke,gk6323v100c-dw-mshc", "snps,dw-mshc";
			reg = <0xf9830000 0x1000>, <0xf8a21000 0x40>;
			interrupts = <0 35 4>;
			clocks = <&clk_50m>, <&clk_50m>;
			clock-names = "biu", "ciu";
			fifo-depth = <0x100>;
			card-detect-delay = <200>;
			bus-width = <8>;
			non-removable;
			mmc-ddr-1_8v;
			disable-wp;
		};

		/* 板载百兆网口：PHY 挂在下面的 mdio 总线上，地址 2 */
		femac: ethernet@f9c30000 {
			compatible = "hisilicon,hisi-femac-v2";
			reg = <0xf9c30000 0x1000>, <0xf9c31300 0x300>;
			interrupts = <0 72 4>;
			clocks = <&clk_75m>;
			phy-mode = "mii";
			phy-handle = <&phy2>;
		};

		mdio@f9c31100 {
			compatible = "hisilicon,hisi-femac-mdio";
			reg = <0xf9c31100 0x100>;
			clocks = <&clk_75m>;
			#address-cells = <1>;
			#size-cells = <0>;

			phy2: ethernet-phy@2 {
				reg = <0x2>;
			};
		};

		/* USB2.0：真机只有 EHCI/OHCI，无 xhci */
		ohci: usb@f9880000 {
			compatible = "generic-ohci";
			reg = <0xf9880000 0x10000>;
			interrupts = <0 67 4>;
		};

		ehci: usb@f9890000 {
			compatible = "generic-ehci";
			reg = <0xf9890000 0x10000>;
			interrupts = <0 66 4>;
		};

		/* SP805 看门狗：也是 panic 后重启的复位通道 */
		watchdog@f8a2c000 {
			compatible = "arm,sp805-wdt", "arm,primecell";
			reg = <0xf8a2c000 0x1000>;
			clocks = <&clk_24m>;
			clock-names = "apb_pclk";
			clock-frequency = <24000000>;
			timeout-sec = <60>;
		};
	};
};
